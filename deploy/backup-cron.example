# /etc/cron.d/3dp-workshop-backup (例)
# 毎日 03:30 に SQLite (オンラインバックアップ) と作品ファイルを退避し、14 日分だけ残す。
30 3 * * * root /bin/bash -c 'set -e; D=/var/backups/3dp-workshop/$(date +\%F); mkdir -p "$D"; sqlite3 /var/lib/3dp-workshop/app.db ".backup $D/app.db"; tar -C /var/lib/3dp-workshop -czf "$D/storage.tar.gz" storage; find /var/backups/3dp-workshop -mindepth 1 -maxdepth 1 -mtime +14 -exec rm -rf {} +'
