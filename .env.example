# --- 基本 ---
# 公開 URL の origin (OAuth redirect / editor の api パラメータ用)。開発: http://localhost:3010
APP_ORIGIN=http://localhost:3010
# SQLite。本番は file:/var/lib/3dp-workshop/app.db
DATABASE_URL=file:./dev.db
# 作品ファイルの保存先 (projects/<uid>/<ts>.lyl)
STORAGE_DIR=./data/storage
# セッション JWT の署名鍵 (32 文字以上のランダム文字列)
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# --- Google OAuth (開催者ログイン) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 許可するメールドメインをカンマ区切りで (空なら制限なし)
ALLOWED_EMAIL_DOMAINS=

# --- 開発用パスワードログイン (本番は false 推奨。未設定時は非 production で true) ---
PASSWORD_LOGIN_ENABLED=true

# --- 上限 ---
MAX_PROJECT_BYTES=52428800
MAX_THUMBNAIL_BYTES=5242880
KEEP_VERSIONS=20

# --- エディタ ---
# iframe が読み込むエディタの URL (本番は既定の /3dp-workshop/editor/ を Nginx が配信)
EDITOR_BASE_URL=/3dp-workshop/editor/
# 開発時のみ: エディタの dev サーバ URL。/3dp-workshop/editor/* をここへリライトして同一オリジン化する
EDITOR_DEV_URL=
